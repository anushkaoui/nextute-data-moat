# Application database role (RLS enforced). Use a pooled URL on serverless Postgres.
DATABASE_URL=postgresql://app_rw:change-me@localhost:55432/postgres

# Admin URL is only for migrations/seed scripts. Do not add it to Vercel.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/postgres

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Optional inbound WhatsApp webhook secret.
WHATSAPP_WEBHOOK_SECRET=demo-whatsapp
